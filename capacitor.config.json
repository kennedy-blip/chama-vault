{
  "appId": "com.chamavault.ledger",
  "appName": "ChamaVault",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0c0b0a",
    "buildOptions": {
      "releaseType": "APK"
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0c0b0a",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
